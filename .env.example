APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# NIK encryption (todo 50). NOT the same as APP_KEY and not derived from it:
# APP_KEY rotates for reasons that have nothing to do with patient identity, and
# coupling the two would re-derive every NIK blind index when it does.
# Generate one per environment with:
#   php -r "echo base64_encode(random_bytes(32)) . PHP_EOL;"
# 32 random bytes, base64. Left EMPTY here on purpose - a key in a tracked file is
# not a key. With this unset, any read or write of a NIK column raises rather
# than falling back to a default.
NIK_CIPHER_KEY=
# Keys that may still DECRYPT rows, comma separated, used while a rotation
# re-encrypts the table. Read-only: nothing new is ever written under a key
# listed here. Empty means no history.
NIK_CIPHER_PREVIOUS_KEYS=

# OTP and push delivery (F-005). Both default to `log`, which writes to the
# application log and is the ONLY driver permitted in local/testing:
# `App\Support\Security\PenjagaPengirimanProduksi` refuses to boot with `log`
# outside those environments, because no account holder can receive a code and no
# device receives a push from a log line.
#
# `fonnte` is an UNOFFICIAL prototype WhatsApp channel - no SLA, and a real risk of
# the number being blocked by WhatsApp. See docs/otp-push-prototype.md; before real
# patient data, move to WhatsApp Cloud API / an official BSP, or a contracted SMS
# gateway. The token is a secret and is never committed.
OTP_DRIVER=log
FONNTE_TOKEN=
FONNTE_URL=https://api.fonnte.com/send
FONNTE_TIMEOUT=10
#
# `fcm` posts to Firebase Cloud Messaging HTTP v1. FIREBASE_CREDENTIALS is a PATH to
# a Google service-account JSON that lives OUTSIDE this repository; the path is
# never committed and .gitignore refuses the console's download names.
PUSH_DRIVER=log
FIREBASE_CREDENTIALS=
FIREBASE_PROJECT_ID=
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_ENDPOINT=https://fcm.googleapis.com/v1
FIREBASE_TIMEOUT=10

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Development database. Named to match the CREATE DATABASE in telemedicine_test.sql,
# which stays a reference artifact only - migrations are the runtime schema.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=telemedisin_db
DB_USERNAME=root
# Leave empty for a passwordless local MySQL. Set a real secret outside version control.
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Database the test suite runs against. phpunit.xml pins the same name so CI
# converges without a .env; php artisan db:create-test-database provisions it.
DB_TEST_DATABASE=telemedisin_db_test

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# `reverb` since todo 31. This is the client-side half (config/broadcasting.php);
# the server-side half is config/reverb.php. A checkout that only wants to inspect
# payloads without standing up a server can set `log` here instead - `null`
# discards them, which is what phpunit.xml:24 pins for the suite.
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Generated by `php artisan reverb:install`. `REVERB_APP_SECRET` is a shared
# secret: anything holding it can sign a broadcast authorization request that
# Laravel accepts, so the values below are placeholders, not credentials. A
# real deployment overwrites all three with the output of that command.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
