{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["frontend/AGENTS.md", "frontend/src/styles/app.css", "frontend/ux/patterns/*.md"],
  "mcp": {
    "shadcn": {
      "type": "local",
      "command": ["npx", "shadcn@latest", "mcp"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  }
}
