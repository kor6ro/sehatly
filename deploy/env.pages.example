# Cloudflare Pages build-time variables.
#
# Copy these into: Pages project -> Settings -> Environment variables ->
# Production. Vite inlines them into the bundle, so a change requires a new
# deployment, not just a restart.
#
# Domain demo saat ini: sehatly.k6devs.my.id. `VITE_API_ORIGIN` adalah origin
# API TANPA `/api/v1`; lib/http.ts menambahkan path versi itu.
NODE_VERSION=22

VITE_API_ORIGIN=https://api.sehatly.k6devs.my.id
VITE_BROADCAST_DRIVER=pusher
VITE_PUSHER_APP_KEY=replace-with-pusher-key
VITE_PUSHER_CLUSTER=ap1
VITE_PUSHER_FORCE_TLS=true

# Optional; the document title is currently hard-coded in index.html.
# VITE_APP_NAME=Sehatly
