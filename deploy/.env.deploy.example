# Salin file ini menjadi deploy/.env.deploy, lalu isi nilai asli.
#
# deploy/.env.deploy TIDAK di-commit (lihat .gitignore) dan tidak masuk image
# Docker. Jangan pernah menempelkan isi file ini ke chat, issue, atau commit.
#
# File ini dipakai oleh:
#   - deploy/seed-tidb.ps1 (database)
#   - operator yang mengisi Environment Variables Render/Pages
#
# Nilai yang AMAN dikirim ke chat: host TiDB, username TiDB (tanpa password),
# nama service Render, URL pages.dev, dan app key Pusher (public).
# Nilai yang JANGAN dikirim ke chat: password TiDB, secret Pusher, API token.

# --- Laravel / Render -------------------------------------------------------
# Aku isi otomatis saat file ini disalin oleh setup; kamu tidak perlu membuat
# ulang. Kalau kosong, generate dengan perintah di deploy/README.md.
APP_KEY=
NIK_CIPHER_KEY=

# --- TiDB Cloud -------------------------------------------------------------
TIDB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_DATABASE=sehatly
TIDB_USER=REPLACE_WITH_PREFIX.root
TIDB_PASSWORD=REPLACE_WITH_PASSWORD
# Path ke ca.pem hasil download dari tombol Connect TiDB (opsional di Windows).
TIDB_CA_PATH=

# --- Pusher Channels --------------------------------------------------------
PUSHER_APP_ID=REPLACE_WITH_APP_ID
PUSHER_APP_KEY=REPLACE_WITH_KEY
PUSHER_APP_SECRET=REPLACE_WITH_SECRET
PUSHER_APP_CLUSTER=ap1

# --- Optional: untuk otomasi (kalau mau aku bantu lewat API) ----------------
# Render: Account Settings -> API Keys. Scope secukupnya.
RENDER_API_KEY=
# Cloudflare: My Profile -> API Tokens. Scope: Account.Cloudflare Pages:Edit,
# Account.Account Settings:Read, Zone.DNS:Edit (kalau perlu).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- Domain -----------------------------------------------------------------
DOMAIN=sehatly.k6devs.my.id
API_DOMAIN=api.sehatly.k6devs.my.id
