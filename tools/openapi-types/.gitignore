# Dependencies of the isolated OpenAPI type generator.
#
# Must be ignored for the same reason `web/node_modules` is: these are installed
# artifacts, not source, and the whole tree is reproducible from the two versions
# pinned in `package.json`.
/node_modules

# `openapi-typescript` writes through stdout only, but a future version that
# gains a cache directory would otherwise start showing up as untracked.
/.openapi-typescript/
